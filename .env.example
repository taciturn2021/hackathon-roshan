# Copy to .env (never commit .env).
AI_GATEWAY_API_KEY=
STT_MODEL=microsoft/mai-transcribe-2
STT_FALLBACK_MODEL=google/gemini-3.5-transcribe
LLM_MODEL=anthropic/claude-haiku-5.5
LLM_FALLBACK_MODEL=openai/gpt-6-luna
JEV_MODEL=typesafe-ai/jev
TTS_MODEL=

# Firebase Auth. Values from Firebase console → Project settings → Your apps → Web app.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Backend (optional). Comma-separated extra browser origins allowed by the API, e.g. https://hackathon.taciturn2021.dpdns.org
CORS_ORIGINS=
# Path to a Firebase service-account JSON (optional; token verification works without it)
GOOGLE_APPLICATION_CREDENTIALS=
# AUTH_DEV=1 accepts "dev:<uid>" bearer tokens for curl/tests. Never set in production.
AUTH_DEV=

# Frontend switches for local work (leave empty normally).
# VITE_DEV_AUTH=<name> signs in with dev tokens instead of Firebase; needs AUTH_DEV=1 on the API.
# VITE_MOCK_API=true runs the screens on an in-browser mock backend, no API needed.
VITE_DEV_AUTH=
VITE_MOCK_API=
